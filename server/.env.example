# =============================================================================
# Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=teatimechat

# Used by Prisma and the application (use Docker service name in docker-compose)
DATABASE_URL="postgresql://postgres:change_me_strong_password@postgres:5432/teatimechat"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# JWT Secrets — minimum 32 characters each
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_minimum_32_characters_access_secret_here
JWT_REFRESH_SECRET=change_me_minimum_32_characters_refresh_secret_here

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime — stored in DB, rotated on each use
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Media Uploads
# ---------------------------------------------------------------------------
# Maximum file size in megabytes
MAX_FILE_SIZE_MB=50

# Local upload directory (relative to server root, dev only)
# In production, replace with S3/R2/MinIO bucket configuration
UPLOAD_DIR=./uploads
